# FLASK ROUTE

@app.route("/", methods=["GET", "POST"])
def home():

    weather = None

    location = None

    current = None

    forecast = None

    error = None


    if request.method == "POST":

        city = request.form.get(
            "city",
            ""
        ).strip()


        if not city:

            error = "Please enter a city name."

        else:

            location = get_coordinates(city)


            if location is None:

                error = "City not found."


            else:

                weather = get_weather(

                    location["latitude"],

                    location["longitude"]

                )


                if weather is None:

                    error = (
                        "Failed to fetch weather data."
                    )

                    weather = None


                else:

                    # Current weather

                    current_data = weather["current"]

                    icon, description = (
                        weather_description(
                            current_data[
                                "weather_code"
                            ]
                        )
                    )


                    current = {

                        "icon": icon,

                        "description": description,

                        "temperature":
                            current_data[
                                "temperature_2m"
                            ],

                        "feels_like":
                            current_data[
                                "apparent_temperature"
                            ],

                        "humidity":
                            current_data[
                                "relative_humidity_2m"
                            ],

                        "wind":
                            current_data[
                                "wind_speed_10m"
                            ],

                        "precipitation":
                            current_data[
                                "precipitation"
                            ]
                    }


                    # 7-day forecast

                    daily = weather["daily"]

                    forecast = []


                    for i in range(
                        len(daily["time"])
                    ):

                        icon, description = (
                            weather_description(
                                daily[
                                    "weather_code"
                                ][i]
                            )
                        )


                        forecast.append({

                            "day":
                                daily[
                                    "time"
                                ][i],

                            "date":
                                daily[
                                    "time"
                                ][i],

                            "icon": icon,

                            "description":
                                description,

                            "min":
                                daily[
                                    "temperature_2m_min"
                                ][i],

                            "max":
                                daily[
                                    "temperature_2m_max"
                                ][i],

                            "rain":
                                daily[
                                    "precipitation_probability_max"
                                ][i]

                        })


    return render_template_string(

        HTML,

        weather=weather,

        location=location,

        current=current,

        forecast=forecast,

        error=error

    )

